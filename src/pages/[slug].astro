---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const updated = guide.data.updated.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<Base
  title={guide.data.title}
  description={guide.data.description}
  updated={guide.data.updated}
  hero={guide.data.image ? { image: guide.data.image, title: guide.data.title, kicker: 'Tangier Insider guide' } : undefined}
>
  <article>
    {!guide.data.image && <h1>{guide.data.title}</h1>}
    <p class="meta">Last checked: {updated} · Written by a Tangier local</p>
    <Content />
  </article>
</Base>
