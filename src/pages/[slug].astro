---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Collage from '../components/Collage.astro';
import { looks, fallbackLook } from '../data/looks';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const updated = guide.data.updated.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const look = looks[guide.id] ?? fallbackLook;
---
<Base title={guide.data.title} description={guide.data.description} updated={guide.data.updated} ogImage={look.photos[0]}>
  <header class="guide-head" slot="wide" style={`--accent: ${look.color}`}>
    <div class="guide-head-inner">
      <div class="guide-head-text">
        <p class="kicker">Tangier Insider guide</p>
        <h1>{guide.data.title}</h1>
        <p class="guide-head-meta">Last checked: {updated} · Written by a Tangier local</p>
      </div>
      <Collage photos={look.photos} eager />
    </div>
    <div class="zellige" aria-hidden="true"></div>
  </header>
  <article>
    <Content />
  </article>
</Base>
