---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Weather from '../components/Weather.astro';

interface Props {
  title: string;
  description: string;
  updated?: Date;
  // Optional full-width photo banner at the top of the page.
  hero?: { image: string; title: string; subtitle?: string; kicker?: string; cta?: { href: string; label: string } };
}

const { title, description, updated, hero } = Astro.props;
const ogImage = hero ? new URL(`/images/${hero.image}.webp`, Astro.site) : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | Tangier Insider`;
const year = new Date().getFullYear();
// Only reviewed (non-draft) guides appear in the menu, so no link ever points to a missing page.
const navOrder = ['tangier-in-one-day', 'ferry-tarifa-tangier', 'things-to-do-in-tangier', 'is-tangier-safe', 'tangier-train-al-boraq', 'darija-for-travelers'];
const navLabels: Record<string, string> = {
  'tangier-in-one-day': '1 day',
  'ferry-tarifa-tangier': 'Ferry',
  'things-to-do-in-tangier': 'Things to do',
  'is-tangier-safe': 'Safety',
  'tangier-train-al-boraq': 'Train',
  'darija-for-travelers': 'Darija',
};
const published = (await getCollection('guides', ({ data }) => !data.draft)).map((g) => g.id);
const navItems = navOrder.filter((id) => published.includes(id));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tangier Insider" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  </head>
  <body>
    <header class={hero ? 'site-header on-hero' : 'site-header'}>
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span class="brand-text">Tangier <em>Insider</em></span>
        </a>
        <Weather />
        <nav class="site-nav" aria-label="Main">
          {navItems.map((id) => <a href={`/${id}/`} aria-current={Astro.url.pathname === `/${id}/` ? 'page' : undefined}>{navLabels[id]}</a>)}
        </nav>
      </div>
    </header>

    {hero && (
      <section class="hero" style={`--hero: url('/images/${hero.image}.webp')`}>
        <div class="hero-inner">
          {hero.kicker && <p class="hero-kicker">{hero.kicker}</p>}
          <h1>{hero.title}</h1>
          {hero.subtitle && <p class="hero-sub">{hero.subtitle}</p>}
          {hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}
        </div>
        <div class="hero-pattern" aria-hidden="true"></div>
      </section>
    )}

    <main>
      <slot name="wide" />
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
        <p>© {year} Tangier Insider. Independent travel guide written by a Tangier local. Not affiliated with any ferry company or government office. Always confirm prices and schedules on official websites.</p>
        <p class="credit">Weather data: <a href="https://www.met.no/en">MET Norway</a> (CC BY 4.0).</p>
      </div>
    </footer>
  </body>
</html>
